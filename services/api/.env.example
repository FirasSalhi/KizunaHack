# Database connection URL (PostgreSQL + TimescaleDB with asyncpg)
DATABASE_URL=postgresql+asyncpg://farmlink:farmlink@localhost:5433/farmlink

# MQTT broker URL for device communication
MQTT_URL=mqtts://localhost:8883

# Object storage endpoint URL (SeaweedFS S3 gateway for local development)
S3_ENDPOINT=http://localhost:8333

# S3 bucket name for plant scan photos
S3_BUCKET=farmlink-photos

# S3 access key (local SeaweedFS uses farmlink-dev, see infra/docker-compose.yml)
S3_ACCESS_KEY=farmlink-dev

# S3 secret key (local SeaweedFS dev value; never reuse outside development)
S3_SECRET_KEY=farmlink-dev-secret

# Secret key for JWT access tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=

# 32-byte encryption key for device AES-GCM secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
DEVICE_KEY_ENCRYPTION_KEY=

# VAPID public key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=

# VAPID private key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=

# VAPID contact subject email or URL
VAPID_SUBJECT=mailto:admin@example.com

# Cookie Secure flag (false for local HTTP development, true in production)
COOKIE_SECURE=false

# Origins allowed to call the API from a browser (comma-separated). Default: localhost:3000 and :8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
